---
import { footerNav } from "../../config/navigation";
import { t } from "../../config/translations";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const nav = footerNav[locale];
---

<footer class="bg-stone-900 text-stone-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
      <div class="col-span-2 md:col-span-1">
        <span class="text-xl font-bold text-white">{locale === "zh" ? "攀岩知识库" : "Climbing KB"}</span>
        <p class="mt-2 text-sm text-stone-400">{t("footer.copyright", locale)}</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">{locale === "zh" ? "更多" : "More"}</h3>
        <ul class="space-y-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-stone-700 text-center text-sm text-stone-500">
      &copy; {new Date().getFullYear()} {locale === "zh" ? "攀岩知识库" : "Climbing Knowledge Base"}
    </div>
  </div>
</footer>
