---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";
import { mainNav } from "../../config/navigation";
import { site } from "../../config/site";
import { t } from "../../config/translations";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const nav = mainNav[locale];
const siteName = locale === "zh" ? site.name : site.nameEn;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={`/${locale}/`} class="flex items-center gap-2 font-bold text-lg text-primary whitespace-nowrap">
        <span class="text-2xl">&#x1F9D7;</span>
        <span class="hidden sm:inline">{siteName}</span>
        <span class="sm:hidden">{locale === "zh" ? "攀岩" : "Climb"}</span>
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        {nav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-stone-600 hover:text-primary rounded-lg hover:bg-stone-100 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <LanguageSwitcher />
        <MobileNav locale={locale} />
      </div>
    </div>
  </div>
</header>
