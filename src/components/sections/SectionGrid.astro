---
import Card from "../ui/Card.astro";

interface Section {
  title: string;
  description: string;
  href: string;
  icon: string;
}

interface Props {
  sections: Section[];
  title: string;
}

const { sections, title } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h2 class="text-2xl md:text-3xl font-bold text-stone-800 mb-8 text-center">{title}</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {sections.map((s) => <Card {...s} />)}
  </div>
</section>
