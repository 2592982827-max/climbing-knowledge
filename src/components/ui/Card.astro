---
export interface CardProps {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const { title, description, href, icon = "🧗" } = Astro.props;
---

<a
  href={href}
  class="group block p-6 bg-white rounded-xl border border-stone-200 hover:border-primary hover:shadow-md transition-all duration-200"
>
  <div class="text-3xl mb-3">{icon}</div>
  <h3 class="text-lg font-semibold text-stone-800 group-hover:text-primary transition-colors mb-2">
    {title}
  </h3>
  <p class="text-sm text-stone-500 leading-relaxed">{description}</p>
</a>
