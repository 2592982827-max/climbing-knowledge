---
type Variant = "info" | "warning" | "tip" | "danger";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const variants: Record<Variant, { bg: string; border: string; text: string; icon: string }> = {
  info: { bg: "bg-blue-50", border: "border-blue-300", text: "text-blue-800", icon: "&#x2139;" },
  warning: { bg: "bg-yellow-50", border: "border-yellow-300", text: "text-yellow-800", icon: "&#x26A0;" },
  tip: { bg: "bg-green-50", border: "border-green-300", text: "text-green-800", icon: "&#x1F4A1;" },
  danger: { bg: "bg-red-50", border: "border-red-300", text: "text-red-800", icon: "&#x26D4;" },
};

const v = variants[variant];
---

<div class={`${v.bg} ${v.text} border-l-4 ${v.border} rounded-r-lg p-4 my-4`}>
  <div class="flex items-start gap-3">
    <span class="text-lg flex-shrink-0" set:html={v.icon} />
    <div>
      <slot />
    </div>
  </div>
</div>
