---
import ArticleLayout from "../layouts/ArticleLayout.astro";
import TableOfContents from "./ui/TableOfContents.astro";
import BackToTop from "./ui/BackToTop.astro";

interface Props {
  title: string;
  description: string;
  locale: string;
  pubDateStr?: string;
  ogImage?: string;
}

const { title, description, locale, pubDateStr, ogImage } = Astro.props;
---

<ArticleLayout
  title={title}
  description={description}
  locale={locale}
  pubDateStr={pubDateStr}
  ogImage={ogImage}
>
  <TableOfContents slot="aside" locale={locale} />
  <slot />
  <BackToTop />
</ArticleLayout>
