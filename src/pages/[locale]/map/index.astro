---
import FullWidthLayout from "../../../layouts/FullWidthLayout.astro";
import CragMap from "../../../components/map/CragMap.astro";

export function getStaticPaths() {
  return [{ params: { locale: "zh" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params;
const isZh = locale === "zh";
const title = isZh ? "攀岩地图" : "Climbing Map";
const desc = isZh
  ? "中国境内岩馆与户外岩场的交互式地图，支持按类型筛选。"
  : "Interactive map of climbing gyms and outdoor crags across China. Filter by type.";
---

<FullWidthLayout title={title} description={desc} locale={locale}>
  <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 mb-2">{title}</h1>
  <p class="text-stone-500 mb-8">{desc}</p>
  <CragMap {locale} />
</FullWidthLayout>
